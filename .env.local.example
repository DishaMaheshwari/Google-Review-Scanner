# ─── Required ────────────────────────────────────────────────────────────────

# Your Groq API key. Server-side only — this is never sent to the browser.
# Free, no credit card: https://console.groq.com/keys
GROQ_API_KEY=

# Where customers go to post their review.
# NEXT_PUBLIC_ means this IS visible in the browser, which is fine: it is a
# public link. Never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=


# ─── Optional ────────────────────────────────────────────────────────────────

# Model used to draft reviews. Defaults to openai/gpt-oss-120b (free on Groq).
# Other good free-tier options: openai/gpt-oss-20b, qwen/qwen3.6-27b
LLM_MODEL=

# The provider endpoint. Defaults to Groq's OpenAI-compatible API.
# Any OpenAI-compatible endpoint works. Set to a single "-" to use the OpenAI
# SDK's own default (api.openai.com) — then put an OpenAI key in LLM_API_KEY.
LLM_BASE_URL=

# Alternative to GROQ_API_KEY, for when you are not on Groq.
LLM_API_KEY=

# Reasoning effort, for models that support it: none | minimal | low | medium | high
# Leave blank to use the model's default. "low" is plenty for a 50-word review.
LLM_REASONING_EFFORT=

# Sampling temperature. Leave blank unless your model supports it and you want
# more variation than the built-in style rotation already gives.
LLM_TEMPERATURE=

# If set, feedback from 1–3 star ratings is POSTed here as {"text": "..."}.
# A Slack or Google Chat incoming webhook works out of the box.
# Leave blank and feedback goes to the server log only.
FEEDBACK_WEBHOOK_URL=
